# Copy to .env and fill in real values. Never commit .env.

# --- Application ---------------------------------------------------------------
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS. "*" is for local development only.
CORS_ORIGINS=*
# Maximum accepted contract upload size (MB)
MAX_UPLOAD_MB=25
# Base URL the Streamlit UI uses to reach the API
BACKEND_URL=http://localhost:8000

# --- Model providers -----------------------------------------------------------
# Anthropic: extraction, synthesis, vision, MCP redlines
ANTHROPIC_API_KEY=
# OpenAI: risk analysis, embeddings (text-embedding-3-small), vision fallback
OPENAI_API_KEY=
# Google: comparator agent (Gemini)
GOOGLE_API_KEY=
# Groq: query rewriting, regulatory summaries, actionability scoring
GROQ_API_KEY=
# Cohere: reranking
COHERE_API_KEY=

# --- Vector database (Milvus / Zilliz Cloud) -----------------------------------
ZILLIZ_CLOUD_URI=
ZILLIZ_CLOUD_API_KEY=

# --- Relational database (PostgreSQL) ------------------------------------------
# Async SQLAlchemy URL. postgres:// and sslmode= forms are normalised automatically.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/legalintel?ssl=require
# Synchronous URL used by Alembic. Optional: derived from DATABASE_URL when empty.
DATABASE_URL_SYNC=
# Password for the local PostgreSQL container started by docker-compose.yml
POSTGRES_PASSWORD=

# --- Datadog (optional) --------------------------------------------------------
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=legal-intel-agent
DD_ENV=development
# localhost when running the API directly; datadog-agent with the Compose observability profile
DD_AGENT_HOST=localhost
DD_AGENT_PORT=8126
DD_DOGSTATSD_PORT=8125
# false disables all Datadog emission (traces and metrics)
DD_TRACE_ENABLED=true
# Attach prompt/response excerpts (contract text) to Datadog LLM spans. Leave false for confidential data.
DD_CAPTURE_LLM_CONTENT=false

# --- Feature flags -------------------------------------------------------------
# Claude Vision enrichment of PDF pages (cost scales with page count, first 20 pages)
ENABLE_VISION_PROCESSING=true

# --- Regulatory monitoring -----------------------------------------------------
# Comma-separated source URLs polled for changes. Example values:
# REGULATORY_SOURCES=https://www.sebi.gov.in/sebiweb/other/OtherAction.do?doListing=yes&sid=5&ssid=18&smid=0,https://www.rbi.org.in/Scripts/BS_CircularIndexDisplay.aspx
REGULATORY_SOURCES=

# --- Retrieval and chunking (optional; defaults shown) -------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_TOP_K=10
# RERANK_TOP_K=5
# CACHE_SIMILARITY_THRESHOLD=0.92
# CONTRACTS_COLLECTION=legal_contracts
# REGULATORY_COLLECTION=regulatory_documents
# CACHE_COLLECTION=semantic_cache
