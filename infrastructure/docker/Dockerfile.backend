FROM python:3.11-slim

# System libraries for PDF rasterisation, OCR and file-type detection
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    libmagic1 \
    tesseract-ocr \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini ./
COPY alembic ./alembic
COPY backend ./backend

RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER appuser

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    DD_SERVICE=legal-intel-agent \
    DD_ENV=production \
    DD_VERSION=1.0.0 \
    DD_LOGS_INJECTION=true \
    DD_RUNTIME_METRICS_ENABLED=true

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

# ddtrace-run instruments FastAPI, SQLAlchemy and HTTP clients at process start.
# Set DD_TRACE_ENABLED=false to run without a Datadog Agent.
CMD ["ddtrace-run", "uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
